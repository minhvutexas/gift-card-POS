# Copy to /opt/giftcard/api/.env (install.sh does this and fills the secrets).
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://giftcard:DB_PASSWORD@localhost:5432/giftcard
JWT_SECRET=CHANGE_ME
QR_SECRET=CHANGE_ME
PUBLIC_URL=https://pos.example.com
CORS_ORIGINS=https://pos.example.com
REQUIRE_TERMINAL_KEY=true
TRUST_PROXY=loopback
# Single-salon install only: Salon ID to use when a device sends none.
# Leave empty for multi-salon (devices use their terminal key or Salon ID).
DEFAULT_BUSINESS=
BACKUP_DIR=/var/backups/giftcard
# Salons create their own account at https://<domain>/signup
SIGNUP_ENABLED=true
SIGNUP_PER_HOUR=5
# Your login for https://<domain>/platform (list/suspend salons, reset owners)
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
# Optional messaging
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
